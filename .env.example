# Next.js and Prisma (server-only secrets; never use NEXT_PUBLIC_ prefixes).
DATABASE_URL="postgresql://gatekeeper_app:replace-with-a-random-password@127.0.0.1:55432/gatekeeper_local?schema=public"
JWT_SECRET="replace-with-a-unique-random-secret-of-at-least-32-characters"
FASTAPI_URL="http://127.0.0.1:8000"
APP_BASE_URL="http://127.0.0.1:3000"

# Optional local bootstrap: npm run db:seed. No existing passwords are replaced.
ADMIN_EMAIL="admin@gatekeeper.local"
ADMIN_PASSWORD="replace-with-a-generated-password-of-at-least-16-characters"

# Email remains disabled until real SMTP credentials are supplied.
EMAIL_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="no-reply@gatekeeper.local"
SMTP_FROM_NAME="GateShield Security System"
ADMIN_NOTIFICATION_EMAIL="admin@gatekeeper.local"

# Optional existing local PostgreSQL cluster: npm run dev:db.
POSTGRES_BIN_PATH="C:/path/to/postgresql/bin"
POSTGRES_DATA_PATH="C:/path/to/pgdata"
POSTGRES_PORT="55432"
POSTGRES_LOG_PATH="C:/path/to/postgres.log"
