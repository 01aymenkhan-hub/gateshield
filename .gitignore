# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python & backend
venv/
.venv/
*/venv/
*/.venv/
__pycache__/
*.py[cod]
*$py.class
backend/uploads/*
!backend/uploads/.gitkeep
/uploads/*
!/uploads/.gitkeep
.paddlex/
official_models/

# local test & scratch assets
scratch_*.jpg
*.log

# Local OCR workers and private real-card test fixtures
/.local/
/uploads/
/backend/samples/old-cnic-pic.jpg
