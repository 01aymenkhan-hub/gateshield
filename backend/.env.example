# Used by npm run dev:backend (run from repository root; Node 20.6+).
OCR_PYTHON_EXECUTABLE="python"
OCR_PORT="8000"
OCR_ENGINE="onnxruntime"
OCR_CPU_THREADS="2"
OCR_WORKERS="3"
OCR_QUEUE_SIZE="4"
OCR_QUEUE_TIMEOUT_SECONDS="15"
OCR_MAX_UPLOAD_MB="15"
OCR_MAX_PIXELS="32000000"
OCR_ENABLE_URDU="false"
OCR_CORS_ORIGINS="http://127.0.0.1:3000,http://localhost:3000"
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK="True"
# Optional persistent cache locations; omit to use library defaults.
# PADDLE_PDX_CACHE_HOME="C:/path/to/model-cache"
# HF_HOME="C:/path/to/hf-cache"
# Optional pre-provisioned model directories:
# OCR_TEXT_DETECTION_MODEL_DIR="C:/path/to/medium-detector"
# OCR_TEXT_RECOGNITION_MODEL_DIR="C:/path/to/medium-recognizer"
# OCR_ORIENTATION_MODEL_DIR="C:/path/to/orientation-model"

# Legacy research assets below are unused by the current fast old-CNIC mode.
# Names are manual; the launcher starts only the OCR API and its process pool.
# OCR_URDU_URL="http://127.0.0.1:8011"
# OCR_URDU_BINARY="C:/private/urdu-worker/runtime/llama-server.exe"
# OCR_URDU_MODEL="C:/private/urdu-worker/models/Qwen3VL-2B-Instruct-Q4_K_M.gguf"
# OCR_URDU_MMPROJ="C:/private/urdu-worker/models/mmproj-Qwen3VL-2B-Instruct-Q8_0.gguf"
# OCR_URDU_KEY_FILE="C:/private/urdu-worker/worker.key"
# Offline IndicXlit ONNX directory containing verified encoder/decoder/vocabulary.
# OCR_TRANSLITERATION_DIR="C:/private/indicxlit"
